# Supabase: Project Settings > Database > Connection string > URI (use the pooler / port 6543 on Render)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000,https://your-app.vercel.app
# Google Calendar API key (Sri Lankan holidays). Calendar API only, no billing needed.
GOOGLE_API_KEY=
